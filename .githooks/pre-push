#!/usr/bin/env bash
# Codecov's patch check is blocking on PRs: changed lines must be covered by
# tests. Catch that here instead of after the PR is opened.
if [ -n "$SKIP_COVERAGE" ]; then
    echo "SKIP_COVERAGE set — skipping the patch coverage check."
    exit 0
fi

base=$(git merge-base origin/main HEAD 2>/dev/null || git merge-base main HEAD 2>/dev/null)
if [ -z "$base" ]; then
    exit 0
fi

if [ -z "$(git diff --name-only "$base"...HEAD -- src)" ]; then
    echo "No src/ changes — skipping the patch coverage check."
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "✗ uv not found on PATH — install uv or run 'uv run --group dev pytest' manually." >&2
    exit 1
fi

echo "→ pre-push: running tests for the patch coverage check..."
uv run --group dev pytest -q || exit 1
uv run python scripts/check_patch_coverage.py
